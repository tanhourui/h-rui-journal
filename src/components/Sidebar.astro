---
interface EraItem {
  id: string;
  name: string;
  year: number;
  eraTitle: string;
  shortTitle?: string;
  camera: string;
  cameraShort?: string;
  chaptersCount?: string;
  count: string;
}

interface Props {
  eras?: EraItem[];
}

const { eras = [
  { id: 'japan-2025', name: 'Japan 2025', year: 2025, eraTitle: 'Mirrorless Discipline & Peak Light', shortTitle: 'Mirrorless', camera: 'Sony α6400', cameraShort: 'Sony', chaptersCount: '4 Ch', count: '4 Chapters · 52 Exposures' },
  { id: 'japan-2024', name: 'Japan 2024', year: 2024, eraTitle: 'Leica Optics & Autumn Tone', shortTitle: 'Leica Optics', camera: 'Xiaomi 14 Ultra', cameraShort: 'Xiaomi Leica', chaptersCount: '3 Ch', count: '3 Chapters · 99 Exposures' },
  { id: 'japan-2023', name: 'Japan 2023', year: 2023, eraTitle: 'Mobile Exploration & Wonder', shortTitle: 'Mobile', camera: 'Huawei P40 Pro', cameraShort: 'Huawei Leica', chaptersCount: '3 Ch', count: '3 Chapters · 45 Exposures' },
] } = Astro.props;
---

<aside id="leftSidebar" class="sidebar">
  <div class="sidebar-top">
    <div class="brand-block">
      <a href="/" class="brand-link">
        <h1>H. Rui Journal</h1>
      </a>
      <p class="subtitle font-mono">Selected Journeys / 旅の記録</p>
    </div>

    <div class="nav-section">
      <div class="nav-section-title">Visual Eras · 旅の軌跡</div>
      
      <!-- 3-Segment Era Grid: All 3 visible side-by-side on mobile without horizontal swiping -->
      <div class="country-nav-list">
        {eras.map((era, idx) => (
          <button 
            class={`country-nav-item ${idx === 0 ? 'active' : ''}`}
            data-country={era.id}
          >
            <div class="era-header-row">
              <span class="era-year-badge">{era.year}</span>
              <span class="era-title-text desktop-only">{era.eraTitle}</span>
              <span class="era-title-text mobile-only">{era.shortTitle || era.eraTitle}</span>
            </div>
            <div class="era-sub-meta font-mono desktop-only">
              <span class="camera-pill">{era.camera}</span>
              <span class="chapter-count">{era.count}</span>
            </div>
            <div class="era-sub-meta font-mono mobile-only">
              <span class="camera-pill">{era.cameraShort || era.camera}</span>
              <span class="chapter-count">{era.chaptersCount || ''}</span>
            </div>
          </button>
        ))}
      </div>

      <!-- Mobile Active Era Callout Banner -->
      <div class="mobile-active-era-banner font-mono mobile-only">
        <span class="active-era-bullet">●</span>
        <span id="mobileActiveEraDesc">2025 · Mirrorless Discipline · Sony α6400</span>
      </div>
    </div>

    <!-- Time-Aware Atmosphere Indicator -->
    <div class="time-atmosphere-pill desktop-only">
      <span class="atmosphere-dot"></span>
      <span id="timeAtmosphereText">Auto Palette</span>
    </div>
  </div>

  <!-- Sidebar Footer -->
  <div class="sidebar-footer font-mono desktop-only">
    <div class="author-name">Tan Hou Rui</div>
    <div class="footer-sub">Visual Archive & Field Journal</div>
    <div class="social-row">
      <a href="https://instagram.com/hourui95" target="_blank" rel="noopener noreferrer" class="social-link">
        <span class="social-tag">IG</span> @hourui95 ↗
      </a>
    </div>
  </div>
</aside>

<style>
  .sidebar {
    width: 320px;
    min-width: 300px;
    height: 100vh;
    padding: 36px 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-right: 1px solid var(--border-subtle);
    background: var(--bg-canvas);
    z-index: 20;
    flex-shrink: 0;
    transition: border-color 0.4s ease, background-color 0.4s ease;
  }

  .brand-link {
    text-decoration: none;
    color: inherit;
  }

  .brand-block h1 {
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--ink-primary);
  }

  .brand-block .subtitle {
    font-size: 11px;
    color: var(--ink-muted);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-top: 4px;
  }

  .nav-section {
    margin-top: 36px;
  }

  .nav-section-title {
    font-size: 10px;
    font-family: 'JetBrains Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--ink-muted);
    margin-bottom: 12px;
  }

  .country-nav-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .country-nav-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding: 12px 14px;
    border-radius: 12px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--ink-muted);
    cursor: pointer;
    text-align: left;
    transition: all 0.25s ease;
    width: 100%;
  }

  .country-nav-item:hover {
    background: rgba(128,128,128,0.06);
    color: var(--ink-primary);
    border-color: var(--border-subtle);
    transform: translateX(2px);
  }

  .country-nav-item.active {
    background: var(--sub-accent-light);
    border-color: var(--sub-accent);
    color: var(--ink-primary);
    box-shadow: 0 4px 14px rgba(0,0,0,0.04);
  }

  .era-header-row {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
  }

  .era-year-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--border-subtle);
    color: var(--ink-primary);
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }

  .country-nav-item.active .era-year-badge {
    background: var(--sub-accent);
    color: #fff;
  }

  .era-title-text {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--ink-primary);
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .era-sub-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    font-size: 10px;
    color: var(--ink-muted);
    margin-top: 2px;
  }

  .camera-pill {
    opacity: 0.85;
  }

  .chapter-count {
    opacity: 0.75;
  }

  .mobile-only {
    display: none;
  }

  .desktop-only {
    display: inherit;
  }

  .time-atmosphere-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 8px;
    background: var(--card-surface);
    border: 1px solid var(--border-subtle);
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--sub-accent);
    margin-top: 24px;
  }

  .atmosphere-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--sub-accent);
  }

  .sidebar-footer {
    font-size: 11px;
    font-family: 'JetBrains Mono', monospace;
    color: var(--ink-muted);
    line-height: 1.6;
  }

  .footer-sub {
    opacity: 0.75;
    font-size: 10px;
  }

  .social-row {
    margin-top: 10px;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: var(--ink-primary);
    text-decoration: none;
    padding: 3px 8px;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.03);
    border: 1px solid var(--border-subtle);
    transition: all 0.2s ease;
  }

  .social-link:hover {
    border-color: var(--ink-primary);
    background: rgba(0, 0, 0, 0.06);
  }

  .social-tag {
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--sub-accent);
  }

  /* Responsive Mobile 3-Segment Timeline Layout */
  @media (max-width: 900px) {
    .sidebar {
      width: 100%;
      height: auto;
      border-right: none;
      border-bottom: 1px solid var(--border-subtle);
      padding: 14px 16px 12px;
    }

    .brand-block {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 8px;
    }

    .brand-block h1 {
      font-size: 18px;
    }

    .brand-block .subtitle {
      font-size: 9.5px;
      margin-top: 0;
    }

    .nav-section {
      margin-top: 10px;
    }

    .nav-section-title {
      font-size: 9px;
      margin-bottom: 6px;
      letter-spacing: 0.14em;
    }

    /* 3 equal columns: 100% visible on screen, zero hidden swipe */
    .country-nav-list {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 6px;
      width: 100%;
    }

    .country-nav-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 8px 4px 7px;
      border-radius: 8px;
      width: 100%;
      min-width: 0;
      gap: 2px;
    }

    .country-nav-item:hover {
      transform: none;
    }

    .era-header-row {
      flex-direction: column;
      align-items: center;
      gap: 2px;
      width: 100%;
    }

    .era-year-badge {
      font-size: 10.5px;
      padding: 1px 6px;
      border-radius: 3px;
    }

    .era-title-text {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: -0.01em;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      width: 100%;
      text-align: center;
    }

    .era-sub-meta {
      flex-direction: column;
      align-items: center;
      gap: 1px;
      font-size: 8.5px;
      width: 100%;
      margin-top: 0;
    }

    .camera-pill {
      font-size: 8.5px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 100%;
      text-align: center;
    }

    .chapter-count {
      font-size: 8px;
      opacity: 0.75;
    }

    .mobile-only {
      display: block;
    }

    .desktop-only {
      display: none !important;
    }

    .mobile-active-era-banner {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      margin-top: 8px;
      padding: 5px 10px;
      border-radius: 6px;
      background: var(--card-surface);
      border: 1px solid var(--border-subtle);
      font-size: 10px;
      color: var(--sub-accent);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      text-align: center;
    }

    .mobile-active-era-banner .active-era-bullet {
      font-size: 7px;
      color: var(--sub-accent);
      flex-shrink: 0;
    }
  }
</style>
