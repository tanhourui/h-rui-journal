---
interface CountrySummary {
  id: string;
  name: string;
  count: string;
}

const countries: CountrySummary[] = [
  { id: 'japan', name: '01. Japan', count: '3 Chapters (2025)' }
];
---

<aside id="leftSidebar" class="sidebar">
  <div class="sidebar-top">
    <div class="brand-block">
      <a href="/" class="brand-link">
        <h1>H. Rui Journal</h1>
      </a>
      <p class="subtitle font-mono">Selected Journeys / 旅の記録</p>
    </div>

    <div class="nav-section">
      <div class="nav-section-title">Destinations</div>
      <div class="country-nav-list">
        {countries.map((c, idx) => (
          <button 
            class={`country-nav-item ${idx === 0 ? 'active' : ''}`}
            data-country={c.id}
          >
            <span>{c.name}</span>
            <span class="chapter-count">{c.count}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Time-Aware Atmosphere Indicator -->
    <div class="time-atmosphere-pill">
      <span class="atmosphere-dot"></span>
      <span id="timeAtmosphereText">Auto Palette</span>
    </div>
  </div>

  <!-- Sidebar Footer -->
  <div class="sidebar-footer font-mono">
    <div class="author-name">Tan Hou Rui</div>
    <div class="footer-sub">Visual Archive & Field Journal</div>
    <div class="social-row">
      <a href="https://instagram.com/hourui95" target="_blank" rel="noopener noreferrer" class="social-link">
        <span class="social-tag">IG</span> @hourui95 ↗
      </a>
    </div>
  </div>
</aside>

<style>
  .sidebar {
    width: 280px;
    min-width: 260px;
    height: 100vh;
    padding: 36px 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-right: 1px solid var(--border-subtle);
    background: var(--bg-canvas);
    z-index: 20;
    flex-shrink: 0;
    transition: border-color 0.4s ease, background-color 0.4s ease;
  }

  .brand-link {
    text-decoration: none;
    color: inherit;
  }

  .brand-block h1 {
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--ink-primary);
  }

  .brand-block .subtitle {
    font-size: 11px;
    color: var(--ink-muted);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-top: 4px;
  }

  .nav-section {
    margin-top: 36px;
  }

  .nav-section-title {
    font-size: 10px;
    font-family: 'JetBrains Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--ink-muted);
    margin-bottom: 12px;
  }

  .country-nav-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .country-nav-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 11px 14px;
    border-radius: 10px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--ink-muted);
    font-size: 13px;
    font-family: 'JetBrains Mono', monospace;
    cursor: pointer;
    text-align: left;
    transition: all 0.2s ease;
  }

  .country-nav-item:hover {
    background: rgba(128,128,128,0.06);
    color: var(--ink-primary);
    border-color: var(--border-subtle);
  }

  .country-nav-item.active {
    background: var(--sub-accent-light);
    border-color: var(--sub-accent);
    color: var(--sub-accent);
    font-weight: 500;
  }

  .country-nav-item .chapter-count {
    font-size: 10px;
    opacity: 0.8;
  }

  .time-atmosphere-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 8px;
    background: var(--card-surface);
    border: 1px solid var(--border-subtle);
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--sub-accent);
    margin-top: 24px;
  }

  .atmosphere-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--sub-accent);
  }

  .sidebar-footer {
    font-size: 11px;
    font-family: 'JetBrains Mono', monospace;
    color: var(--ink-muted);
    line-height: 1.6;
  }

  .footer-sub {
    opacity: 0.75;
    font-size: 10px;
  }

  .social-row {
    margin-top: 10px;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: var(--ink-primary);
    text-decoration: none;
    padding: 3px 8px;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.03);
    border: 1px solid var(--border-subtle);
    transition: all 0.2s ease;
  }

  .social-link:hover {
    border-color: var(--ink-primary);
    background: rgba(0, 0, 0, 0.06);
  }

  .social-tag {
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--sub-accent);
  }

  @media (max-width: 1200px) {
    .sidebar {
      width: 100%;
      height: auto;
      border-right: none;
      border-bottom: 1px solid var(--border-subtle);
      padding: 20px;
    }
  }
</style>
