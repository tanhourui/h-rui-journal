---
interface Props {
  journeysData: any;
}

const { journeysData } = Astro.props;
---

<div class="globe-stage-wrapper">
  <!-- State, Country & Coordinates Tab Centered Directly on Top of the Globe -->
  <div class="globe-top-badge">
    <span class="dot"></span>
    <span id="activeRegionText" style="font-weight:600;">Tokyo · Japan</span>
    <span class="sep">·</span>
    <span id="activeCoordsText">35.712° N, 139.762° E</span>
  </div>

  <div class="viewport-grid">
    <!-- Center Canvas: Globe Stage with Trajectory Arcs & Stable Ring -->
    <div class="canvas-container">
      <canvas id="globeCanvas" width="680" height="680"></canvas>
    </div>

    <!-- Right Column: Connected Cards with Direct Hairline from Globe -->
    <div id="cardsColumn" class="cards-column"></div>
  </div>

  <!-- Floating Zoom Controls -->
  <div class="zoom-controls">
    <button id="zoomInBtn" class="zoom-btn" title="Zoom In">+</button>
    <button id="zoomOutBtn" class="zoom-btn" title="Zoom Out">−</button>
  </div>
</div>

<script is:inline src="/d3.min.js"></script>
<script is:inline src="/topojson-client.min.js"></script>
<script is:inline src="/world-data.js"></script>
<script is:inline src="/country-dots.js"></script>

<script is:inline define:vars={{ initialJourneys: journeysData }}>
  window.JOURNEYS_DATA = initialJourneys;
</script>

<script is:inline>
  (function() {
    const countries = window.JOURNEYS_DATA || {};

    let currentCountryKey = Object.keys(countries)[0] || 'japan-2025';
    let currentStateIndex = 0;

    const canvas = document.getElementById('globeCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    
    // Fixed Aperture Circle (580px diameter)
    const GLOBE_APERTURE_RADIUS = 290; 
    let cx = canvas.width / 2;
    let cy = canvas.height / 2;

    let currentZoomFactor = 1.0;
    let targetZoomFactor = 1.0;
    const MIN_ZOOM = 0.55;
    const MAX_ZOOM = 3.5;

    let projection = d3.geoOrthographic()
      .scale(GLOBE_APERTURE_RADIUS * currentZoomFactor)
      .translate([cx, cy])
      .precision(0.3);

    let path = d3.geoPath().projection(projection).context(ctx);
    let graticule = d3.geoGraticule10();

    let worldCountries = null;
    if (window.WORLD_ATLAS) {
      worldCountries = topojson.feature(window.WORLD_ATLAS, window.WORLD_ATLAS.objects.countries);
    }

    const landDots = window.COUNTRY_DOTS || [];

    let rot = [-138.25, -36.2];
    let targetRot = [-138.25, -36.2];
    let isDragging = false;
    let lastPos = { x: 0, y: 0 };

    function getThemeColors() {
      const styles = getComputedStyle(document.body);
      return {
        globeBase: styles.getPropertyValue('--globe-base').trim() || '#ECE8DF',
        globeStroke: styles.getPropertyValue('--globe-stroke').trim() || '#D5D0C2',
        landDots: styles.getPropertyValue('--land-dots').trim() || '#C0BAAC',
        countryStroke: styles.getPropertyValue('--country-stroke').trim() || '#746E60',
        ringTicks: styles.getPropertyValue('--ring-ticks').trim() || '#7A7466',
        ringSubtle: styles.getPropertyValue('--ring-subtle').trim() || 'rgba(160, 155, 145, 0.35)',
        accent: styles.getPropertyValue('--sub-accent').trim() || '#3E4D40',
        inkPrimary: styles.getPropertyValue('--ink-primary').trim() || '#21201D',
        routeArc: styles.getPropertyValue('--route-arc').trim() || '#3E4D40'
      };
    }

    function render() {
      rot[0] += (targetRot[0] - rot[0]) * 0.08;
      rot[1] += (targetRot[1] - rot[1]) * 0.08;
      
      currentZoomFactor += (targetZoomFactor - currentZoomFactor) * 0.1;
      projection.scale(GLOBE_APERTURE_RADIUS * currentZoomFactor).rotate(rot);

      ctx.clearRect(0, 0, canvas.width, canvas.height);
      const colors = getThemeColors();

      // 1. STABLE ASTROLABE CALIBRATION RING
      ctx.save();
      ctx.translate(cx, cy);

      ctx.beginPath();
      ctx.arc(0, 0, GLOBE_APERTURE_RADIUS + 26, 0, Math.PI * 2);
      ctx.strokeStyle = colors.ringSubtle;
      ctx.lineWidth = 0.7;
      ctx.stroke();

      ctx.beginPath();
      ctx.arc(0, 0, GLOBE_APERTURE_RADIUS + 12, 0, Math.PI * 2);
      ctx.strokeStyle = colors.ringSubtle;
      ctx.lineWidth = 0.5;
      ctx.stroke();

      for (let deg = 0; deg < 360; deg += 5) {
        const rad = deg * Math.PI / 180;
        const isMajor = (deg % 30 === 0);
        const tickLength = isMajor ? 11 : 5;
        const r1 = GLOBE_APERTURE_RADIUS + 12;
        const r2 = r1 + tickLength;

        const x1 = Math.cos(rad) * r1;
        const y1 = Math.sin(rad) * r1;
        const x2 = Math.cos(rad) * r2;
        const y2 = Math.sin(rad) * r2;

        ctx.beginPath();
        ctx.moveTo(x1, y1);
        ctx.lineTo(x2, y2);
        ctx.lineWidth = isMajor ? 1.2 : 0.5;
        ctx.strokeStyle = isMajor ? colors.ringTicks : colors.ringSubtle;
        ctx.stroke();

        if (isMajor && (deg % 60 === 0)) {
          const textR = r2 + 11;
          const tx = Math.cos(rad) * textR;
          const ty = Math.sin(rad) * textR;
          ctx.font = '8px monospace';
          ctx.fillStyle = colors.ringTicks;
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText(`${deg}°`, tx, ty);
        }
      }
      ctx.restore();

      // 2. Fixed Globe Aperture Circle
      ctx.save();
      ctx.beginPath();
      ctx.arc(cx, cy, GLOBE_APERTURE_RADIUS, 0, Math.PI * 2);
      ctx.fillStyle = colors.globeBase;
      ctx.fill();
      ctx.lineWidth = 1.2;
      ctx.strokeStyle = colors.globeStroke;
      ctx.stroke();
      
      ctx.clip();

      // 3. Graticules
      ctx.beginPath();
      path(graticule);
      ctx.lineWidth = 0.5;
      ctx.strokeStyle = colors.ringSubtle;
      ctx.stroke();

      const rotCenter = [-rot[0], -rot[1]];

      // 4. Render Clean Inset Interior Dots
      const dotSize = Math.max(1.1, 1.35 * currentZoomFactor);
      ctx.fillStyle = colors.landDots;
      landDots.forEach(coord => {
        if (d3.geoDistance(coord, rotCenter) < Math.PI / 2) {
          const pt = projection(coord);
          if (pt) {
            const dCenter = Math.hypot(pt[0] - cx, pt[1] - cy);
            if (dCenter <= GLOBE_APERTURE_RADIUS) {
              ctx.beginPath();
              ctx.arc(pt[0], pt[1], dotSize, 0, Math.PI * 2);
              ctx.fill();
            }
          }
        }
      });

      // 5. Fine Vector Country Boundaries
      if (worldCountries) {
        ctx.beginPath();
        path(worldCountries);
        ctx.lineWidth = Math.min(1.2, 0.75 * currentZoomFactor);
        ctx.strokeStyle = colors.countryStroke;
        ctx.stroke();
      }

      // 6. Travel Trajectory Arcs Connecting Cities
      const countryData = countries[currentCountryKey];
      if (countryData && countryData.route && countryData.route.length > 1) {
        ctx.beginPath();
        for (let i = 0; i < countryData.route.length - 1; i++) {
          const start = countryData.route[i];
          const end = countryData.route[i + 1];
          const interpolate = d3.geoInterpolate(start, end);

          let first = true;
          for (let t = 0; t <= 1; t += 0.05) {
            const coord = interpolate(t);
            if (d3.geoDistance(coord, rotCenter) < Math.PI / 2) {
              const pt = projection(coord);
              if (pt && Math.hypot(pt[0] - cx, pt[1] - cy) <= GLOBE_APERTURE_RADIUS) {
                if (first) { ctx.moveTo(pt[0], pt[1]); first = false; }
                else ctx.lineTo(pt[0], pt[1]);
              }
            }
          }
        }
        ctx.setLineDash([4, 4]);
        ctx.strokeStyle = colors.routeArc;
        ctx.lineWidth = 1.5;
        ctx.stroke();
        ctx.setLineDash([]);
      }

      // 7. Destination Pins Inside Viewfinder
      let activePinPt = null;

      // 7a. Render subtle exploration beacons for all OTHER destinations across the globe
      const renderedBeaconCoords = new Set();
      Object.entries(countries).forEach(([cKey, cObj]) => {
        if (cKey === currentCountryKey || !cObj.states) return;
        // Avoid duplicate pins between overlapping Japan eras
        if (cKey.startsWith('japan') && currentCountryKey.startsWith('japan')) return;

        cObj.states.forEach(s => {
          const coordKey = `${s.coords[0].toFixed(2)},${s.coords[1].toFixed(2)}`;
          if (renderedBeaconCoords.has(coordKey)) return;
          renderedBeaconCoords.add(coordKey);

          const dist = d3.geoDistance(s.coords, rotCenter);
          if (dist < Math.PI / 2) {
            const pt = projection(s.coords);
            if (!pt) return;
            const [px, py] = pt;
            if (Math.hypot(px - cx, py - cy) <= GLOBE_APERTURE_RADIUS) {
              // Soft radar beacon ring
              ctx.beginPath();
              ctx.arc(px, py, 7, 0, Math.PI * 2);
              ctx.fillStyle = colors.accent + '22';
              ctx.fill();

              // Anchor dot
              ctx.beginPath();
              ctx.arc(px, py, 3.5, 0, Math.PI * 2);
              ctx.fillStyle = colors.accent;
              ctx.globalAlpha = 0.65;
              ctx.fill();
              ctx.globalAlpha = 1.0;
            }
          }
        });
      });

      // 7b. Render ACTIVE destination pins, route arcs, and active pill label
      if (countryData && countryData.states) {
        countryData.states.forEach((s, idx) => {
          const coords = s.coords;
          const dist = d3.geoDistance(coords, rotCenter);

          if (dist < Math.PI / 2) {
            const pt = projection(coords);
            if (!pt) return;
            const [px, py] = pt;
            const dCenter = Math.hypot(px - cx, py - cy);
            
            if (dCenter <= GLOBE_APERTURE_RADIUS) {
              const isCurrent = (idx === currentStateIndex);

              if (isCurrent) {
                activePinPt = [px, py];

                ctx.beginPath();
                ctx.arc(px, py, 16, 0, Math.PI * 2);
                ctx.fillStyle = colors.accent + '30';
                ctx.fill();

                ctx.beginPath();
                ctx.arc(px, py, 26, 0, Math.PI * 2);
                ctx.strokeStyle = colors.accent;
                ctx.lineWidth = 1.3;
                ctx.stroke();
              }

              ctx.beginPath();
              ctx.arc(px, py, isCurrent ? 6.5 : 3.8, 0, Math.PI * 2);
              ctx.fillStyle = isCurrent ? colors.accent : colors.countryStroke;
              ctx.fill();

              // ONLY render the text label for the active pin to eliminate word stacking collisions
              if (isCurrent) {
                const shortTitle = s.title.includes(':') ? s.title.split(':')[0] : s.title;
                const labelText = `${s.order ? `0${s.order}. ` : ''}${shortTitle}`;
                ctx.font = 'bold 11px monospace';
                const textWidth = ctx.measureText(labelText).width;

                ctx.save();
                ctx.fillStyle = colors.globeBase || '#ECE8DF';
                ctx.shadowColor = 'rgba(0,0,0,0.18)';
                ctx.shadowBlur = 6;
                ctx.shadowOffsetY = 2;

                const pillW = textWidth + 14;
                const preferredPillX = px + 12;
                const pillX = preferredPillX + pillW <= canvas.width - 8
                  ? preferredPillX
                  : Math.max(8, px - pillW - 12);
                const pillY = py - 11;
                const pillH = 22;

                // Store a safe start point to the right of both the pill and pin.
                window._activePinPillRight = Math.max(pillX + pillW, px + 18);

                ctx.beginPath();
                if (ctx.roundRect) {
                  ctx.roundRect(pillX, pillY, pillW, pillH, 5);
                } else {
                  ctx.rect(pillX, pillY, pillW, pillH);
                }
                ctx.fill();
                ctx.strokeStyle = colors.accent;
                ctx.lineWidth = 1;
                ctx.stroke();
                ctx.restore();

                ctx.fillStyle = colors.accent;
                ctx.fillText(labelText, pillX + 7, py + 4);
              }
            }
          }
        });
      }

      ctx.restore();

      // 8. Hairline Connecting Pin to Active Right Card
      if (activePinPt) {
        const [px, py] = activePinPt;
        const cardEl = document.querySelector('.chapter-card.active');
        
        if (cardEl && window.innerWidth > 1180) {
          const canvasRect = canvas.getBoundingClientRect();
          const cardRect = cardEl.getBoundingClientRect();
          const scaleX = canvas.width / canvasRect.width;
          const scaleY = canvas.height / canvasRect.height;

          // The canvas backing store remains 680px while CSS can scale it down.
          // Convert viewport pixels back to canvas coordinates before drawing.
          const targetX = (cardRect.left - canvasRect.left) * scaleX;
          const targetY = (cardRect.top + cardRect.height / 2 - canvasRect.top) * scaleY;

          // Start the line from the right edge of the label pill (+ 6px gap)
          // so it never cuts through the pill text
          const lineStartX = window._activePinPillRight
            ? window._activePinPillRight + 6
            : px + 30;

          const midX = lineStartX + (targetX - lineStartX) * 0.55;

          ctx.beginPath();
          ctx.moveTo(lineStartX, py);
          ctx.lineTo(midX, py);
          ctx.lineTo(targetX - 10, targetY);
          ctx.lineTo(targetX, targetY);

          ctx.lineWidth = 1.2;
          ctx.strokeStyle = colors.accent;
          ctx.stroke();

          ctx.beginPath();
          ctx.arc(targetX, targetY, 3.5, 0, Math.PI * 2);
          ctx.fillStyle = colors.accent;
          ctx.fill();
        }
      }

      requestAnimationFrame(render);
    }

    // DOM Elements
    const activeRegionText = document.getElementById('activeRegionText');
    const activeCoordsText = document.getElementById('activeCoordsText');
    const cardsColumn = document.getElementById('cardsColumn');

    function updateCountryCards(countryKey) {
      if (!cardsColumn) return;
      cardsColumn.innerHTML = '';
      const c = countries[countryKey];
      if (!c || !c.states) return;

      c.states.forEach((s, idx) => {
        const card = document.createElement('div');
        card.className = `chapter-card ${idx === currentStateIndex ? 'active' : ''}`;
        card.setAttribute('data-index', idx);

        card.innerHTML = `
          <div class="card-bezel-wrapper">
            <div class="card-inner-surface">
              <div class="collapsed-row">
                <div class="collapsed-left font-mono">
                  <span class="chapter-idx-pill">0${idx+1}</span>
                  <span class="collapsed-copy">
                    <span class="state-name-sm">${s.title}</span>
                    <span class="date-meta-sm">${s.date}</span>
                  </span>
                </div>
                <span class="expand-chevron font-mono">▾</span>
              </div>
              <div class="expanded-content">
                <div class="card-img-wrap">
                  <img src="${s.hero}" alt="${s.title}" loading="lazy">
                  <span class="story-tag font-mono">Chapter 0${idx+1}</span>
                </div>
                <p class="card-desc">${s.desc}</p>
                <div class="card-action-bar">
                  <span class="exif-meta font-mono">${s.exif}</span>
                  <a href="/journey/${s.slug}" class="story-cta-pill font-mono">
                    <span>Read Story</span>
                    <span class="cta-arrow-bubble">↗</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        `;

        card.addEventListener('mouseenter', () => {
          if (window.innerWidth > 900) selectState(idx);
        });

        card.addEventListener('click', (e) => {
          if (!e.target.closest('.story-cta-pill')) {
            selectState(idx);
          }
        });

        cardsColumn.appendChild(card);
      });
    }

    let lastActiveJapanEra = 'japan-2025';

    function selectCountry(countryKey, stateIndex = 0, updateRotation = true) {
      currentCountryKey = countryKey;
      currentStateIndex = stateIndex;
      const c = countries[countryKey];
      if (!c) return;
      const s = c.states[stateIndex] || c.states[0];

      if (s) {
        if (updateRotation) {
          targetRot = [-s.coords[0], -s.coords[1]];
        }
        if (activeRegionText) activeRegionText.textContent = `${s.stateName} · ${c.countryName || c.name}`;
        if (activeCoordsText) activeCoordsText.textContent = s.coordsText;
      }

      // Sync country-nav-item active state
      document.querySelectorAll('.country-nav-item').forEach(btn => {
        if (btn.getAttribute('data-country') === countryKey) {
          btn.className = 'country-nav-item active';
        } else {
          btn.className = 'country-nav-item';
        }
      });

      // Sync parent destination tab and panel
      const parentDestId = countryKey.startsWith('japan') ? 'japan' : countryKey;
      document.querySelectorAll('.dest-tab-btn').forEach(db => {
        if (db.getAttribute('data-destination') === parentDestId) db.classList.add('active');
        else db.classList.remove('active');
      });
      document.querySelectorAll('.destination-panel').forEach(dp => {
        if (dp.getAttribute('data-destination-panel') === parentDestId) dp.classList.add('active');
        else dp.classList.remove('active');
      });

      // Update mobile callout banner without equipment gear names
      const mobileActiveEraDesc = document.getElementById('mobileActiveEraDesc');
      if (mobileActiveEraDesc && c) {
        const totalExp = c.states ? c.states.reduce((acc, st) => acc + (st.gallery?.length || 0) + 1 + (st.sub1 ? 1 : 0) + (st.sub2 ? 1 : 0), 0) : 0;
        const eraLabel = c.shortTitle || c.eraTitle || '';
        mobileActiveEraDesc.textContent = `${c.name} ${c.year || ''} · ${eraLabel} · ${totalExp} Exp`;
      }

      updateCountryCards(countryKey);
    }

    window.selectCountry = selectCountry;
    window.selectState = selectState;

    function selectState(stateIndex, updateRotation = true) {
      currentStateIndex = stateIndex;
      const c = countries[currentCountryKey];
      if (!c || !c.states[stateIndex]) return;
      const s = c.states[stateIndex];

      if (updateRotation) {
        targetRot = [-s.coords[0], -s.coords[1]];
      }

      if (activeRegionText) activeRegionText.textContent = `${s.stateName} · ${c.countryName || c.name}`;
      if (activeCoordsText) activeCoordsText.textContent = s.coordsText;

      document.querySelectorAll('.chapter-card').forEach((card, idx) => {
        if (idx === stateIndex) {
          card.classList.add('active');
        } else {
          card.classList.remove('active');
        }
      });
    }

    // Automatically detect which country is targeted when the user spins the globe
    function detectCenteredCountry() {
      let curLon = -targetRot[0];
      curLon = ((curLon + 180) % 360 + 360) % 360 - 180;
      const curLat = Math.max(-85, Math.min(85, -targetRot[1]));
      const rotCenter = [curLon, curLat];

      const candidates = [];

      // Check Malaysia
      if (countries['malaysia'] && countries['malaysia'].states) {
        let minD = Infinity;
        countries['malaysia'].states.forEach(s => {
          const d = d3.geoDistance(rotCenter, s.coords);
          if (d < minD) minD = d;
        });
        candidates.push({ key: 'malaysia', dest: 'malaysia', dist: minD });
      }

      // Check Thailand
      if (countries['thailand'] && countries['thailand'].states) {
        let minD = Infinity;
        countries['thailand'].states.forEach(s => {
          const d = d3.geoDistance(rotCenter, s.coords);
          if (d < minD) minD = d;
        });
        candidates.push({ key: 'thailand', dest: 'thailand', dist: minD });
      }

      // Check Vietnam
      if (countries['vietnam'] && countries['vietnam'].states) {
        let minD = Infinity;
        countries['vietnam'].states.forEach(s => {
          const d = d3.geoDistance(rotCenter, s.coords);
          if (d < minD) minD = d;
        });
        candidates.push({ key: 'vietnam', dest: 'vietnam', dist: minD });
      }

      // Check Japan (closest pin across any Japan era)
      let minJapanD = Infinity;
      Object.keys(countries).filter(k => k.startsWith('japan')).forEach(jKey => {
        if (countries[jKey] && countries[jKey].states) {
          countries[jKey].states.forEach(s => {
            const d = d3.geoDistance(rotCenter, s.coords);
            if (d < minJapanD) minJapanD = d;
          });
        }
      });
      const activeJKey = currentCountryKey.startsWith('japan') ? currentCountryKey : lastActiveJapanEra;
      candidates.push({ key: activeJKey, dest: 'japan', dist: minJapanD });

      // Sort by closest distance
      candidates.sort((a, b) => a.dist - b.dist);
      const closest = candidates[0];

      // Threshold: about 0.45 radians (~26 degrees)
      if (closest && closest.dist < 0.45) {
        let targetKey = closest.key;
        if (closest.dest === 'japan') {
          targetKey = currentCountryKey.startsWith('japan') ? currentCountryKey : lastActiveJapanEra;
        } else if (currentCountryKey.startsWith('japan')) {
          lastActiveJapanEra = currentCountryKey;
        }

        if (targetKey !== currentCountryKey) {
          // Switch active country, cards, and sidebar without jerking rotation
          selectCountry(targetKey, 0, false);
        }
      }
    }

    function zoomIn() {
      targetZoomFactor = Math.min(MAX_ZOOM, targetZoomFactor + 0.3);
    }
    function zoomOut() {
      targetZoomFactor = Math.max(MIN_ZOOM, targetZoomFactor - 0.3);
    }

    const zoomInBtn = document.getElementById('zoomInBtn');
    const zoomOutBtn = document.getElementById('zoomOutBtn');
    if (zoomInBtn) zoomInBtn.addEventListener('click', zoomIn);
    if (zoomOutBtn) zoomOutBtn.addEventListener('click', zoomOut);

    canvas.addEventListener('wheel', (e) => {
      e.preventDefault();
      if (e.deltaY < 0) zoomIn();
      else zoomOut();
    }, { passive: false });

    let dragMovement = 0;

    function handleStart(clientX, clientY) {
      isDragging = true;
      dragMovement = 0;
      lastPos = { x: clientX, y: clientY };
    }

    function handleMove(clientX, clientY) {
      if (!isDragging) return;
      const rect = canvas.getBoundingClientRect();
      const clientDx = clientX - lastPos.x;
      const clientDy = clientY - lastPos.y;
      const dx = clientDx * (canvas.width / rect.width);
      const dy = clientDy * (canvas.height / rect.height);
      dragMovement += Math.hypot(clientDx, clientDy);
      targetRot[0] += dx * (0.45 / currentZoomFactor);
      targetRot[1] = Math.max(-65, Math.min(65, targetRot[1] - dy * (0.35 / currentZoomFactor)));
      lastPos = { x: clientX, y: clientY };
      detectCenteredCountry();
    }

    function handleEnd() {
      isDragging = false;
      detectCenteredCountry();
    }

    canvas.addEventListener('mousedown', (e) => handleStart(e.clientX, e.clientY));
    window.addEventListener('mousemove', (e) => handleMove(e.clientX, e.clientY));
    window.addEventListener('mouseup', handleEnd);

    let pinchStartDist = 0;
    let pinchStartZoom = 1.0;
    let lastTapTime = 0;

    canvas.addEventListener('touchstart', (e) => {
      if (e.touches.length === 1) {
        handleStart(e.touches[0].clientX, e.touches[0].clientY);
      } else if (e.touches.length === 2) {
        isDragging = false;
        const dx = e.touches[0].clientX - e.touches[1].clientX;
        const dy = e.touches[0].clientY - e.touches[1].clientY;
        pinchStartDist = Math.hypot(dx, dy);
        pinchStartZoom = targetZoomFactor;
      }
    }, { passive: true });

    window.addEventListener('touchmove', (e) => {
      if (e.touches.length === 1) {
        handleMove(e.touches[0].clientX, e.touches[0].clientY);
      } else if (e.touches.length === 2 && pinchStartDist > 0) {
        const dx = e.touches[0].clientX - e.touches[1].clientX;
        const dy = e.touches[0].clientY - e.touches[1].clientY;
        const currentDist = Math.hypot(dx, dy);
        const scale = currentDist / pinchStartDist;
        targetZoomFactor = Math.max(MIN_ZOOM, Math.min(MAX_ZOOM, pinchStartZoom * scale));
        if (e.cancelable) e.preventDefault();
      }
    }, { passive: false });

    window.addEventListener('touchend', (e) => {
      if (e.touches.length < 2) {
        pinchStartDist = 0;
      }
      if (e.touches.length === 0) {
        handleEnd();
        const now = Date.now();
        if (now - lastTapTime < 300) {
          // Double tap toggles zoom
          if (targetZoomFactor > 1.35) targetZoomFactor = 1.0;
          else targetZoomFactor = 2.1;
        }
        lastTapTime = now;
      }
    });

    document.querySelectorAll('.country-nav-item').forEach(btn => {
      btn.addEventListener('click', () => {
        const countryKey = btn.getAttribute('data-country');
        selectCountry(countryKey, 0, true);
      });
    });

    canvas.addEventListener('click', (e) => {
      // If user dragged the globe, do not treat as pin click
      if (dragMovement > 7) return;

      const rect = canvas.getBoundingClientRect();
      const clickX = (e.clientX - rect.left) * (canvas.width / rect.width);
      const clickY = (e.clientY - rect.top) * (canvas.height / rect.height);
      const rotCenter = [-rot[0], -rot[1]];

      let pinFound = false;

      // 1. Check current active country pins first
      const currentCountryObj = countries[currentCountryKey];
      if (currentCountryObj && currentCountryObj.states) {
        currentCountryObj.states.forEach((s, idx) => {
          if (d3.geoDistance(s.coords, rotCenter) < Math.PI / 2) {
            const pt = projection(s.coords);
            if (pt && Math.hypot(pt[0] - clickX, pt[1] - clickY) < 28) {
              selectState(idx, true);
              pinFound = true;
            }
          }
        });
      }

      // 2. If not found in current country, search all other destinations across the globe!
      if (!pinFound) {
        for (const [cKey, cObj] of Object.entries(countries)) {
          if (cKey === currentCountryKey || !cObj.states) continue;
          for (let idx = 0; idx < cObj.states.length; idx++) {
            const s = cObj.states[idx];
            if (d3.geoDistance(s.coords, rotCenter) < Math.PI / 2) {
              const pt = projection(s.coords);
              if (pt && Math.hypot(pt[0] - clickX, pt[1] - clickY) < 28) {
                selectCountry(cKey, idx, true);
                pinFound = true;
                break;
              }
            }
          }
          if (pinFound) break;
        }
      }
    });

    // Start in active primary era
    const params = new URLSearchParams(window.location.search);
    const requestedEra = params.get('era');
    const requestedChapter = params.get('chapter');
    const defaultEra = requestedEra && countries[requestedEra] ? requestedEra : (Object.keys(countries)[0] || 'japan-2025');
    const restoredIndex = requestedChapter && countries[defaultEra]?.states
      ? Math.max(0, countries[defaultEra].states.findIndex(state => state.slug === requestedChapter))
      : 0;
    selectCountry(defaultEra, restoredIndex);
    render();
  })();
</script>

