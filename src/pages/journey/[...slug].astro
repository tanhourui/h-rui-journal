<script is:inline>
  (function() {
    const shareBtn = document.getElementById('shareChapterBtn');
    const shareFeedback = document.getElementById('shareFeedback');
    const shareFeedbackText = document.getElementById('shareFeedbackText');
    const shareFallbackUrl = document.getElementById('shareFallbackUrl');
    let shareFeedbackTimer = 0;

    function showShareFeedback(message, url = '') {
      if (!shareFeedback || !shareFeedbackText || !shareFallbackUrl) return;
      window.clearTimeout(shareFeedbackTimer);
      shareFeedbackText.textContent = message;
      shareFallbackUrl.hidden = !url;
      shareFallbackUrl.value = url;
      shareFeedback.hidden = false;

      if (url) {
        shareFallbackUrl.focus();
        shareFallbackUrl.select();
      } else {
        shareFeedbackTimer = window.setTimeout(() => {
          shareFeedback.hidden = true;
        }, 2400);
      }
    }

    async function copyShareUrl(url) {
      if (window.isSecureContext && navigator.clipboard?.writeText) {
        try {
          await navigator.clipboard.writeText(url);
          showShareFeedback('Link copied');
          return;
        } catch (_) {
          // The selectable URL below remains available if clipboard access is denied.
        }
      }
      showShareFeedback('Copy this chapter link:', url);
    }

    shareBtn?.addEventListener('click', async () => {
      if (shareBtn.disabled) return;
      shareBtn.disabled = true;
      shareBtn.setAttribute('aria-busy', 'true');

      const url = new URL(window.location.pathname, window.location.origin).href;
      const title = shareBtn.getAttribute('data-share-title') || document.title;
      const shareData = { title, url };
      let canUseNativeShare = typeof navigator.share === 'function';

      if (canUseNativeShare && typeof navigator.canShare === 'function') {
        try {
          canUseNativeShare = navigator.canShare(shareData);
        } catch (_) {
          canUseNativeShare = false;
        }
      }

      try {
        if (canUseNativeShare) {
          try {
            await navigator.share(shareData);
            return;
          } catch (error) {
            if (error instanceof DOMException && error.name === 'AbortError') return;
          }
        }

        await copyShareUrl(url);
      } finally {
        shareBtn.disabled = false;
        shareBtn.removeAttribute('aria-busy');
      }
    });

    const dialog = document.getElementById('lightboxDialog');
    const closeBtn = document.getElementById('lightboxCloseBtn');
    const prevBtn = document.getElementById('lightboxPrevBtn');
    const nextBtn = document.getElementById('lightboxNextBtn');
    const imgEl = document.getElementById('lightboxImg');
    const captionEl = document.getElementById('lightboxCaption');
    const exifEl = document.getElementById('lightboxExif');
    const counterEl = document.getElementById('lightboxCounter');
    const triggers = Array.from(document.querySelectorAll('[data-image][data-caption]'));
    let currentIndex = 0;
    let lastTrigger = null;

    if (!dialog || !triggers.length) return;

    function showImage(index) {
      currentIndex = (index + triggers.length) % triggers.length;
      const trigger = triggers[currentIndex];
      const src = trigger.getAttribute('data-image') || '';
      const caption = trigger.getAttribute('data-caption') || '';
      const exif = trigger.getAttribute('data-exif') || '';
      if (!imgEl) return;
      imgEl.src = src;
      imgEl.alt = caption;
      if (captionEl) captionEl.textContent = caption;
      if (exifEl) {
        exifEl.textContent = exif;
        exifEl.hidden = !exif;
      }
      if (counterEl) counterEl.textContent = `${currentIndex + 1} / ${triggers.length}`;
    }

    function openLightbox(index, trigger) {
      lastTrigger = trigger;
      showImage(index);
      if (!dialog.open) dialog.showModal();
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    }

    function closeLightbox() {
      if (dialog.open) dialog.close();
    }

    triggers.forEach((trigger, index) => {
      trigger.addEventListener('click', () => openLightbox(index, trigger));
    });

    if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
    if (prevBtn) prevBtn.addEventListener('click', () => showImage(currentIndex - 1));
    if (nextBtn) nextBtn.addEventListener('click', () => showImage(currentIndex + 1));
    if (prevBtn) prevBtn.hidden = triggers.length < 2;
    if (nextBtn) nextBtn.hidden = triggers.length < 2;

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) closeLightbox();
    });

    dialog.addEventListener('close', () => {
      if (imgEl) imgEl.src = '';
      document.body.style.overflow = '';
      lastTrigger?.focus();
    });

    window.addEventListener('keydown', (e) => {
      if (!dialog.open) return;
      if (e.key === 'ArrowLeft') showImage(currentIndex - 1);
      if (e.key === 'ArrowRight') showImage(currentIndex + 1);
    });
  })();
</script>
