---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const journeys = await getCollection('journeys');
  return journeys.map(entry => ({
    params: { slug: entry.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const allJourneys = await getCollection('journeys');
const siblings = allJourneys
  .filter(j => j.data.country === entry.data.country && (j.data.year || 2025) === (entry.data.year || 2025))
  .sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

const currentIndex = siblings.findIndex(j => j.slug === entry.slug);
const prevJourney = siblings[(currentIndex - 1 + siblings.length) % siblings.length];
const nextJourney = siblings[(currentIndex + 1) % siblings.length];
const hasSiblingNavigation = siblings.length > 1;
const returnEra = entry.data.country === 'japan'
  ? `japan-${entry.data.year || 2025}`
  : entry.data.country;
const returnHref = `/?country=${encodeURIComponent(entry.data.country)}&era=${encodeURIComponent(returnEra)}&chapter=${encodeURIComponent(entry.slug)}`;
---

<BaseLayout title={`${entry.data.title} · H. Rui Journal`}>
  <div class="story-page">
    <div class="story-container">
      
      <!-- Top Navigation Bar -->
      <nav class="story-nav">
        <div class="story-nav-actions">
          <a href={returnHref} class="return-link font-mono">
            <span class="arrow-bubble">←</span>
            <span>Return to Globe</span>
          </a>
          <button id="shareChapterBtn" class="share-chapter-btn font-mono" type="button" data-share-title={entry.data.chapterTitle}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="18" cy="5" r="2.5"></circle>
              <circle cx="6" cy="12" r="2.5"></circle>
              <circle cx="18" cy="19" r="2.5"></circle>
              <path d="M8.3 10.8 15.7 6.2M8.3 13.2l7.4 4.6"></path>
            </svg>
            <span>Share chapter</span>
          </button>
        </div>
        <div class="meta-right font-mono">
          <span class="time-badge">{entry.data.date}</span>
          {entry.data.time && <span class="time-sub">· {entry.data.time}</span>}
        </div>
        <div id="shareFeedback" class="share-feedback font-mono" role="status" aria-live="polite" hidden>
          <span id="shareFeedbackText"></span>
          <input id="shareFallbackUrl" class="share-fallback-url font-mono" type="text" aria-label="Chapter link to copy" readonly hidden />
        </div>
      </nav>

      <!-- Breadcrumb & Header -->
      <header class="story-header">
        <div class="breadcrumb font-mono">
          <span class="country-tag">{entry.data.countryName}</span>
          <span class="slash">/</span>
          <span class="region-tag">{entry.data.stateName}</span>
          <span class="coords-tag font-mono">{entry.data.coordsText}</span>
        </div>
        <h1 class="story-title">{entry.data.chapterTitle}</h1>
        <p class="story-lead">{entry.data.desc}</p>
      </header>

      <!-- Master Hero Photograph (Double-Bezel Frame) -->
      <section id="masterHeroFrame" class={`master-hero-frame ${entry.data.heroAspect === 'portrait' ? 'is-portrait' : ''}`}>
        <button
          type="button"
          class="image-trigger hero-trigger"
          data-image={entry.data.hero}
          data-caption={entry.data.heroCaption || `${entry.data.title} · Main Exposure`}
          data-exif={entry.data.exif || ''}
          aria-label="View hero photograph"
        >
          <span class="hero-bezel-outer">
            <span class="hero-image-box">
              <img
                id="masterHeroImg"
                src={entry.data.hero}
                alt={entry.data.title}
                onload="if(this.naturalHeight > this.naturalWidth) document.getElementById('masterHeroFrame')?.classList.add('is-portrait')"
              />
            </span>
          </span>
        </button>
        <div class="image-caption-bar font-mono">
          <span class="caption-title">{entry.data.heroCaption || `${entry.data.title} · Main Exposure`}</span>
          <span class="caption-exif-pill">{entry.data.exif}</span>
        </div>
      </section>

      <!-- Essay Prose Content -->
      <section class="story-prose">
        <Content />
      </section>

      <!-- Companion Diptych Grid (Asymmetrical Editorial Rhythm) -->
      {(entry.data.sub1 || entry.data.sub2) && (
        <section class="diptych-section">
          <div class="diptych-heading font-mono">Curated Detail Frames</div>
          <div class="diptych-grid">
            {entry.data.sub1 && (
              <div class="diptych-item item-dominant">
                <button type="button" class="image-trigger diptych-bezel" data-image={entry.data.sub1} data-caption={entry.data.sub1Caption || "Detail Study 01"} data-exif={entry.data.sub1Exif || ""} aria-label="View detail frame 1">
                  <span class="diptych-img-wrap">
                    <img src={entry.data.sub1} alt={entry.data.sub1Caption || "Detail Frame 01"} loading="lazy" />
                  </span>
                </button>
                <div class="diptych-caption font-mono">
                  <span class="sub-title">{entry.data.sub1Caption || "Detail Study 01"}</span>
                  <span class="sub-exif">{entry.data.sub1Exif || ""}</span>
                </div>
              </div>
            )}
            {entry.data.sub2 && (
              <div class="diptych-item item-accent">
                <button type="button" class="image-trigger diptych-bezel" data-image={entry.data.sub2} data-caption={entry.data.sub2Caption || "Detail Study 02"} data-exif={entry.data.sub2Exif || ""} aria-label="View detail frame 2">
                  <span class="diptych-img-wrap">
                    <img src={entry.data.sub2} alt={entry.data.sub2Caption || "Detail Frame 02"} loading="lazy" />
                  </span>
                </button>
                <div class="diptych-caption font-mono">
                  <span class="sub-title">{entry.data.sub2Caption || "Detail Study 02"}</span>
                  <span class="sub-exif">{entry.data.sub2Exif || ""}</span>
                </div>
              </div>
            )}
          </div>
        </section>
      )}

      <!-- Complete Regional Exposures / Chapter Gallery Grid -->
      {entry.data.gallery && entry.data.gallery.length > 0 && (
        <section class="chapter-gallery-section">
          <div class="gallery-header-row font-mono">
            <span class="gallery-heading">Regional Exposures Archive</span>
            <span class="gallery-count">{entry.data.gallery.length} Frames</span>
          </div>
          <div class="chapter-gallery-grid">
            {entry.data.gallery.map((item) => (
              <button
                type="button"
                class="gallery-card"
                data-image={item.image}
                data-caption={item.caption}
                data-exif={item.exif || ''}
                aria-label={`View photograph: ${item.caption}`}
              >
                <div class="gallery-card-inner">
                  <div class="gallery-img-box">
                    <img src={item.image} alt={item.caption} loading="lazy" />
                    <div class="gallery-overlay-hint font-mono">
                      <span>Inspect ↗</span>
                    </div>
                  </div>
                  <div class="gallery-card-info font-mono">
                    <span class="gallery-card-caption">{item.caption}</span>
                    {item.exif && <span class="gallery-card-exif">{item.exif}</span>}
                  </div>
                </div>
              </button>
            ))}
          </div>
        </section>
      )}

      <!-- Fullscreen Lightbox Modal -->
      <dialog id="lightboxDialog" class="lightbox-dialog" aria-labelledby="lightboxCaption">
        <div class="lightbox-content">
          <div class="lightbox-image-wrap">
            <img id="lightboxImg" src="" alt="" />
          </div>
          <div class="lightbox-toolbar">
            <button id="lightboxPrevBtn" class="lightbox-step lightbox-prev font-mono" type="button" aria-label="Previous photograph">←</button>
            <span id="lightboxCounter" class="lightbox-counter font-mono" aria-live="polite"></span>
            <button id="lightboxNextBtn" class="lightbox-step lightbox-next font-mono" type="button" aria-label="Next photograph">→</button>
            <button id="lightboxCloseBtn" class="lightbox-close font-mono" type="button" aria-label="Close image viewer" title="Close (Esc)">×</button>
          </div>
          <div class="lightbox-meta font-mono">
            <div class="lightbox-copy">
              <span id="lightboxCaption" class="lightbox-caption"></span>
              <span id="lightboxExif" class="lightbox-exif"></span>
            </div>
          </div>
        </div>
      </dialog>

      <!-- Chapter Journey Navigation Footer -->
      <footer class="story-footer font-mono">
        {hasSiblingNavigation ? (
          <a href={`/journey/${prevJourney.slug}`} class="chapter-nav-btn chapter-nav-prev">
            <span>← {prevJourney.data.stateName}</span>
          </a>
        ) : <span class="chapter-nav-spacer" aria-hidden="true"></span>}
        <div class="footer-center-meta">
          <span class="footer-center">Tan Hou Rui</span>
          <span class="footer-sep">·</span>
          <a href="https://instagram.com/hourui95" target="_blank" rel="noopener noreferrer" class="footer-ig">@hourui95 ↗</a>
        </div>
        {hasSiblingNavigation ? (
          <a href={`/journey/${nextJourney.slug}`} class="chapter-nav-btn chapter-nav-next">
            <span>{nextJourney.data.stateName} →</span>
          </a>
        ) : <span class="chapter-nav-spacer" aria-hidden="true"></span>}
      </footer>

    </div>
  </div>
</BaseLayout>

<style>
  .story-page {
    width: 100vw;
    min-height: 100vh;
    background: var(--bg-canvas);
    color: var(--ink-primary);
    padding: clamp(28px, 5vw, 56px) clamp(16px, 3vw, 28px) 96px;
  }

  .story-container {
    max-width: 920px;
    margin: 0 auto;
  }

  .story-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 22px;
    margin-bottom: 40px;
  }

  .story-nav-actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .return-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--sub-accent);
    font-size: 12.5px;
    text-decoration: none;
    transition: transform 0.2s ease;
    min-height: 44px;
  }

  .arrow-bubble {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--sub-accent-light);
    color: var(--sub-accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    transition: transform 0.2s ease;
  }

  .return-link:hover {
    transform: translateX(-2px);
  }

  .return-link:hover .arrow-bubble {
    transform: scale(1.08);
  }

  .share-chapter-btn {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 9px;
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    background: var(--card-surface);
    color: var(--sub-accent);
    font-size: 11.5px;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease;
    white-space: nowrap;
  }

  .share-chapter-btn:hover {
    border-color: var(--sub-accent);
    color: var(--ink-primary);
  }

  .share-chapter-btn:focus-visible {
    outline: 2px solid var(--sub-accent);
    outline-offset: 2px;
  }

  .share-chapter-btn:disabled {
    cursor: wait;
  }

  .share-chapter-btn svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex-shrink: 0;
  }

  .share-feedback {
    flex-basis: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 10px;
    color: var(--sub-accent);
    font-size: 11px;
  }

  .share-feedback[hidden] {
    display: none;
  }

  .share-fallback-url {
    min-width: 0;
    flex: 1;
    padding: 7px 9px;
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    background: var(--card-surface);
    color: var(--ink-primary);
    font-size: 11px;
  }

  .meta-right {
    font-size: 11.5px;
    color: var(--ink-muted);
  }

  .story-header {
    margin-bottom: 36px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    margin-bottom: 14px;
  }

  .country-tag {
    color: var(--sub-secondary);
    font-weight: 500;
  }

  .slash {
    color: var(--border-subtle);
  }

  .region-tag {
    color: var(--sub-accent);
    font-weight: 500;
  }

  .footer-center-meta {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .footer-center {
    letter-spacing: 0.05em;
    font-size: 11px;
    color: var(--ink-muted);
  }

  .footer-sep {
    color: var(--border-subtle);
    font-size: 10px;
  }

  .footer-ig {
    font-size: 11px;
    color: var(--ink-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-ig:hover {
    color: var(--sub-accent);
  }

  .coords-tag {
    margin-left: auto;
    font-size: 11px;
    color: var(--ink-muted);
    text-transform: none;
    letter-spacing: normal;
  }

  .story-title {
    font-size: 34px;
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.25;
    margin-bottom: 16px;
  }

  .story-lead {
    font-size: 15.5px;
    color: var(--ink-primary);
    line-height: 1.8;
    font-weight: 300;
    max-width: 720px;
  }

  /* Master Hero Photograph Frame */
  .master-hero-frame {
    margin: 40px 0;
    transition: max-width 0.4s ease, margin 0.4s ease;
  }

  .image-trigger {
    appearance: none;
    border: 0;
    padding: 0;
    width: 100%;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: inherit;
    cursor: zoom-in;
  }

  .image-trigger:focus-visible,
  .gallery-card:focus-visible {
    outline: 2px solid var(--sub-accent);
    outline-offset: 4px;
  }

  .master-hero-frame.is-portrait {
    max-width: 620px;
    margin: 40px auto;
  }

  .hero-bezel-outer {
    display: block;
    padding: 0;
    border-radius: 8px;
    background: transparent;
    border: 1px solid var(--border-subtle);
  }

  .hero-image-box {
    width: 100%;
    border-radius: 7px;
    overflow: hidden;
    background: var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-image-box img {
    width: 100%;
    height: auto;
    max-height: 84vh;
    object-fit: contain;
    display: block;
  }

  .master-hero-frame.is-portrait .hero-image-box img {
    max-height: 80vh;
  }

  .image-caption-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
    color: var(--ink-muted);
    margin-top: 12px;
    padding: 0 4px;
  }

  .caption-exif-pill {
    padding: 3px 9px;
    border-radius: 4px;
    background: var(--card-surface);
    border: 1px solid var(--border-subtle);
    font-size: 10.5px;
    color: var(--ink-muted);
  }

  /* Story Prose */
  .story-prose {
    font-size: 15.5px;
    line-height: 1.9;
    color: var(--ink-primary);
    margin: 48px 0;
    max-width: 68ch;
  }

  .story-prose :global(p) {
    margin-bottom: 22px;
    font-weight: 300;
  }

  /* Asymmetric Diptych Grid */
  .diptych-section {
    margin-top: 64px;
    padding-top: 36px;
    border-top: 1px solid var(--border-subtle);
  }

  .diptych-heading {
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--ink-muted);
    margin-bottom: 24px;
  }

  .diptych-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 24px;
    align-items: end;
  }

  .diptych-item {
    display: flex;
    flex-direction: column;
  }

  .diptych-bezel {
    display: block;
    padding: 0;
    border-radius: 8px;
    background: transparent;
    border: 1px solid var(--border-subtle);
    transition: border-color 0.3s ease;
  }

  .diptych-item:hover .diptych-bezel {
    border-color: var(--sub-accent);
  }

  .item-dominant .diptych-img-wrap {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    border-radius: 7px;
    overflow: hidden;
    background: var(--border-subtle);
  }

  .item-accent .diptych-img-wrap {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    border-radius: 7px;
    overflow: hidden;
    background: var(--border-subtle);
  }

  .diptych-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .diptych-item:hover .diptych-img-wrap img {
    transform: scale(1.03);
  }

  .diptych-caption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 10.5px;
    color: var(--ink-muted);
    margin-top: 10px;
    padding: 0 2px;
  }

  .sub-exif {
    font-size: 10px;
    opacity: 0.85;
  }

  /* Story Footer */
  .story-footer {
    margin-top: 72px;
    padding-top: 32px;
    border-top: 1px solid var(--border-subtle);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    font-size: 12px;
    color: var(--sub-accent);
  }

  .chapter-nav-btn {
    color: inherit;
    text-decoration: none;
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 6px 10px;
    border-radius: 8px;
    border: 1px solid transparent;
    transition: all 0.2s ease;
  }

  .chapter-nav-next {
    justify-self: end;
    text-align: right;
  }

  .chapter-nav-spacer {
    min-width: 1px;
  }

  .chapter-nav-btn:hover {
    border-color: var(--border-subtle);
    background: var(--card-surface);
  }

  .footer-center {
    color: var(--ink-muted);
    font-size: 11px;
  }

  @media (max-width: 768px) {
    .story-title {
      font-size: 26px;
    }
    .hero-image-box img {
      max-height: 75vh;
    }
    .diptych-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .coords-tag {
      display: none;
    }
  }

  /* Bilingual Prose */
  .story-prose :global(.bilingual-block) {
    margin-bottom: 36px;
  }

  .story-prose :global(.en-prose) {
    font-size: 16px;
    line-height: 1.85;
    color: var(--ink-primary);
    font-weight: 300;
    margin-bottom: 12px;
  }

  .story-prose :global(.zh-prose) {
    font-size: 14.5px;
    line-height: 1.85;
    color: var(--ink-muted);
    font-weight: 300;
    border-left: 2px solid var(--border-subtle);
    padding-left: 16px;
    margin-top: 8px;
    margin-bottom: 0;
  }

  /* Chapter Gallery Section */
  .chapter-gallery-section {
    margin-top: 72px;
    padding-top: 36px;
    border-top: 1px solid var(--border-subtle);
  }

  .gallery-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--ink-muted);
  }

  .gallery-count {
    padding: 3px 8px;
    border-radius: 4px;
    background: var(--card-surface);
    border: 1px solid var(--border-subtle);
    font-size: 10px;
    color: var(--sub-accent);
  }

  .chapter-gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .gallery-card {
    display: flex;
    flex-direction: column;
    cursor: pointer;
    appearance: none;
    border: 0;
    padding: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
  }

  .gallery-card-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .gallery-img-box {
    position: relative;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    border-radius: 8px;
    overflow: hidden;
    background: var(--border-subtle);
    border: 1px solid var(--border-subtle);
    padding: 0;
  }

  .gallery-img-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 7px;
    transition: transform 0.4s ease;
  }

  .gallery-card:hover .gallery-img-box img {
    transform: scale(1.04);
  }

  .gallery-overlay-hint {
    position: absolute;
    top: 10px;
    right: 10px;
    background: var(--ink-primary);
    color: var(--bg-canvas);
    font-size: 9.5px;
    padding: 2px 7px;
    border-radius: 4px;
    opacity: 0;
    transform: translateY(-4px);
    transition: all 0.25s ease;
    pointer-events: none;
  }

  .gallery-card:hover .gallery-overlay-hint {
    opacity: 1;
    transform: translateY(0);
  }

  .gallery-card-info {
    margin-top: 8px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 10px;
    color: var(--ink-muted);
  }

  .gallery-card-caption {
    font-size: 11px;
    color: var(--ink-primary);
    font-weight: 400;
  }

  .gallery-card-exif {
    font-size: 9.5px;
    opacity: 0.75;
  }

  /* Native lightbox dialog */
  .lightbox-dialog {
    width: min(1120px, calc(100vw - 32px));
    max-width: none;
    max-height: calc(100dvh - 32px);
    margin: auto;
    padding: 16px;
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    background: var(--card-surface);
    color: var(--ink-primary);
    overflow: hidden;
  }

  .lightbox-dialog::backdrop {
    background: var(--bg-canvas);
    opacity: 0.94;
  }

  .lightbox-content {
    position: relative;
    width: 100%;
