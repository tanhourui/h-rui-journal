---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const journeys = await getCollection('journeys');
  return journeys.map(entry => ({
    params: { slug: entry.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const allJourneys = await getCollection('journeys');
const siblings = allJourneys
  .filter(j => j.data.country === entry.data.country)
  .sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

const currentIndex = siblings.findIndex(j => j.slug === entry.slug);
const prevJourney = siblings[(currentIndex - 1 + siblings.length) % siblings.length];
const nextJourney = siblings[(currentIndex + 1) % siblings.length];
---

<BaseLayout title={`${entry.data.title} · H. Rui Journal`}>
  <div class="story-page">
    <div class="story-container">
      
      <!-- Top Navigation Bar -->
      <nav class="story-nav">
        <a href="/" class="return-link font-mono">
          <span class="arrow-bubble">←</span>
          <span>Return to Globe</span>
        </a>
        <div class="meta-right font-mono">
          <span class="time-badge">{entry.data.date}</span>
          {entry.data.time && <span class="time-sub">· {entry.data.time}</span>}
        </div>
      </nav>

      <!-- Breadcrumb & Header -->
      <header class="story-header">
        <div class="breadcrumb font-mono">
          <span class="country-tag">{entry.data.countryName}</span>
          <span class="slash">/</span>
          <span class="region-tag">{entry.data.stateName}</span>
          <span class="coords-tag font-mono">{entry.data.coordsText}</span>
        </div>
        <h1 class="story-title">{entry.data.chapterTitle}</h1>
        <p class="story-lead">{entry.data.desc}</p>
      </header>

      <!-- Master Hero Photograph (Double-Bezel Frame) -->
      <section class="master-hero-frame">
        <div class="hero-bezel-outer">
          <div class="hero-image-box">
            <img src={entry.data.hero} alt={entry.data.title} />
          </div>
        </div>
        <div class="image-caption-bar font-mono">
          <span class="caption-title">{entry.data.heroCaption || `${entry.data.title} · Main Exposure`}</span>
          <span class="caption-exif-pill">{entry.data.exif}</span>
        </div>
      </section>

      <!-- Essay Prose Content -->
      <section class="story-prose">
        <Content />
      </section>

      <!-- Companion Diptych Grid (Asymmetrical Editorial Rhythm) -->
      {(entry.data.sub1 || entry.data.sub2) && (
        <section class="diptych-section">
          <div class="diptych-heading font-mono">Curated Detail Frames</div>
          <div class="diptych-grid">
            {entry.data.sub1 && (
              <div class="diptych-item item-dominant">
                <div class="diptych-bezel">
                  <div class="diptych-img-wrap">
                    <img src={entry.data.sub1} alt={entry.data.sub1Caption || "Detail Frame 01"} loading="lazy" />
                  </div>
                </div>
                <div class="diptych-caption font-mono">
                  <span class="sub-title">{entry.data.sub1Caption || "Detail Study 01"}</span>
                  <span class="sub-exif">{entry.data.sub1Exif || ""}</span>
                </div>
              </div>
            )}
            {entry.data.sub2 && (
              <div class="diptych-item item-accent">
                <div class="diptych-bezel">
                  <div class="diptych-img-wrap">
                    <img src={entry.data.sub2} alt={entry.data.sub2Caption || "Detail Frame 02"} loading="lazy" />
                  </div>
                </div>
                <div class="diptych-caption font-mono">
                  <span class="sub-title">{entry.data.sub2Caption || "Detail Study 02"}</span>
                  <span class="sub-exif">{entry.data.sub2Exif || ""}</span>
                </div>
              </div>
            )}
          </div>
        </section>
      )}

      <!-- Complete Regional Exposures / Chapter Gallery Grid -->
      {entry.data.gallery && entry.data.gallery.length > 0 && (
        <section class="chapter-gallery-section">
          <div class="gallery-header-row font-mono">
            <span class="gallery-heading">Regional Exposures Archive</span>
            <span class="gallery-count">{entry.data.gallery.length} Frames</span>
          </div>
          <div class="chapter-gallery-grid">
            {entry.data.gallery.map((item) => (
              <div 
                class="gallery-card"
                data-image={item.image}
                data-caption={item.caption}
                data-exif={item.exif || ''}
              >
                <div class="gallery-card-inner">
                  <div class="gallery-img-box">
                    <img src={item.image} alt={item.caption} loading="lazy" />
                    <div class="gallery-overlay-hint font-mono">
                      <span>Inspect ↗</span>
                    </div>
                  </div>
                  <div class="gallery-card-info font-mono">
                    <span class="gallery-card-caption">{item.caption}</span>
                    {item.exif && <span class="gallery-card-exif">{item.exif}</span>}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Fullscreen Lightbox Modal -->
      <div id="lightboxModal" class="lightbox-modal" aria-hidden="true">
        <div class="lightbox-backdrop" id="lightboxBackdrop"></div>
        <div class="lightbox-content">
          <button id="lightboxCloseBtn" class="lightbox-close font-mono" title="Close (Esc)">✕</button>
          <div class="lightbox-image-wrap">
            <img id="lightboxImg" src="" alt="" />
          </div>
          <div class="lightbox-meta font-mono">
            <span id="lightboxCaption" class="lightbox-caption"></span>
            <span id="lightboxExif" class="lightbox-exif"></span>
          </div>
        </div>
      </div>

      <!-- Chapter Journey Navigation Footer -->
      <footer class="story-footer font-mono">
        <a href={`/journey/${prevJourney.slug}`} class="chapter-nav-btn">
          <span>← {prevJourney.data.stateName}</span>
        </a>
        <div class="footer-center-meta">
          <span class="footer-center">Tan Hou Rui</span>
          <span class="footer-sep">·</span>
          <a href="https://instagram.com/hourui95" target="_blank" rel="noopener noreferrer" class="footer-ig">@hourui95 ↗</a>
        </div>
        <a href={`/journey/${nextJourney.slug}`} class="chapter-nav-btn">
          <span>{nextJourney.data.stateName} →</span>
        </a>
      </footer>

    </div>
  </div>
</BaseLayout>

<style>
  .story-page {
    width: 100vw;
    min-height: 100vh;
    background: var(--bg-canvas);
    color: var(--ink-primary);
    padding: 56px 28px 112px;
  }

  .story-container {
    max-width: 920px;
    margin: 0 auto;
  }

  .story-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 22px;
    margin-bottom: 40px;
  }

  .return-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--sub-accent);
    font-size: 12.5px;
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  .arrow-bubble {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--sub-accent-light);
    color: var(--sub-accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    transition: transform 0.2s ease;
  }

  .return-link:hover {
    transform: translateX(-2px);
  }

  .return-link:hover .arrow-bubble {
    transform: scale(1.08);
  }

  .meta-right {
    font-size: 11.5px;
    color: var(--ink-muted);
  }

  .story-header {
    margin-bottom: 36px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    margin-bottom: 14px;
  }

  .country-tag {
    color: var(--sub-secondary);
    font-weight: 500;
  }

  .slash {
    color: var(--border-subtle);
  }

  .region-tag {
    color: var(--sub-accent);
    font-weight: 500;
  }

  .footer-center-meta {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .footer-center {
    letter-spacing: 0.05em;
    font-size: 11px;
    color: var(--ink-muted);
  }

  .footer-sep {
    color: var(--border-subtle);
    font-size: 10px;
  }

  .footer-ig {
    font-size: 11px;
    color: var(--ink-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-ig:hover {
    color: var(--sub-accent);
  }

  .coords-tag {
    margin-left: auto;
    font-size: 11px;
    color: var(--ink-muted);
    text-transform: none;
    letter-spacing: normal;
  }

  .story-title {
    font-size: 34px;
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.25;
    margin-bottom: 16px;
  }

  .story-lead {
    font-size: 15.5px;
    color: var(--ink-muted);
    line-height: 1.8;
    font-weight: 300;
    max-width: 720px;
  }

  /* Master Hero Photograph Frame */
  .master-hero-frame {
    margin: 40px 0;
  }

  .hero-bezel-outer {
    padding: 4px;
    border-radius: 20px;
    background: rgba(128, 128, 128, 0.05);
    border: 1px solid var(--border-subtle);
    box-shadow: 0 12px 36px rgba(0,0,0,0.06);
  }

  .hero-image-box {
    width: 100%;
    height: 540px;
    border-radius: 16px;
    overflow: hidden;
    background: #EAE6DC;
  }

  .hero-image-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-caption-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
    color: var(--ink-muted);
    margin-top: 12px;
    padding: 0 4px;
  }

  .caption-exif-pill {
    padding: 3px 9px;
    border-radius: 6px;
    background: var(--card-surface);
    border: 1px solid var(--border-subtle);
    font-size: 10.5px;
    color: var(--ink-muted);
  }

  /* Story Prose */
  .story-prose {
    font-size: 15.5px;
    line-height: 1.9;
    color: var(--ink-primary);
    margin: 48px 0;
    max-width: 68ch;
  }

  .story-prose :global(p) {
    margin-bottom: 22px;
    font-weight: 300;
  }

  /* Asymmetric Diptych Grid */
  .diptych-section {
    margin-top: 64px;
    padding-top: 36px;
    border-top: 1px solid var(--border-subtle);
  }

  .diptych-heading {
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--ink-muted);
    margin-bottom: 24px;
  }

  .diptych-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 24px;
    align-items: end;
  }

  .diptych-item {
    display: flex;
    flex-direction: column;
  }

  .diptych-bezel {
    padding: 3px;
    border-radius: 16px;
    background: rgba(128, 128, 128, 0.05);
    border: 1px solid var(--border-subtle);
    transition: border-color 0.3s ease;
  }

  .diptych-item:hover .diptych-bezel {
    border-color: var(--sub-accent);
  }

  .item-dominant .diptych-img-wrap {
    width: 100%;
    height: 350px;
    border-radius: 13px;
    overflow: hidden;
    background: #EAE6DC;
  }

  .item-accent .diptych-img-wrap {
    width: 100%;
    height: 290px;
    border-radius: 13px;
    overflow: hidden;
    background: #EAE6DC;
  }

  .diptych-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .diptych-item:hover .diptych-img-wrap img {
    transform: scale(1.03);
  }

  .diptych-caption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 10.5px;
    color: var(--ink-muted);
    margin-top: 10px;
    padding: 0 2px;
  }

  .sub-exif {
    font-size: 10px;
    opacity: 0.85;
  }

  /* Story Footer */
  .story-footer {
    margin-top: 72px;
    padding-top: 32px;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    color: var(--sub-accent);
  }

  .chapter-nav-btn {
    color: inherit;
    text-decoration: none;
    padding: 6px 12px;
    border-radius: 8px;
    border: 1px solid transparent;
    transition: all 0.2s ease;
  }

  .chapter-nav-btn:hover {
    border-color: var(--border-subtle);
    background: var(--card-surface);
  }

  .footer-center {
    color: var(--ink-muted);
    font-size: 11px;
  }

  @media (max-width: 768px) {
    .story-title {
      font-size: 26px;
    }
    .hero-image-box {
      height: 340px;
    }
    .diptych-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .item-dominant .diptych-img-wrap,
    .item-accent .diptych-img-wrap {
      height: 240px;
    }
    .coords-tag {
      display: none;
    }
  }

  /* Bilingual Prose */
  .story-prose :global(.bilingual-block) {
    margin-bottom: 36px;
  }

  .story-prose :global(.en-prose) {
    font-size: 16px;
    line-height: 1.85;
    color: var(--ink-primary);
    font-weight: 300;
    margin-bottom: 12px;
  }

  .story-prose :global(.zh-prose) {
    font-size: 14.5px;
    line-height: 1.85;
    color: var(--ink-muted);
    font-weight: 300;
    border-left: 2px solid var(--border-subtle);
    padding-left: 16px;
    margin-top: 8px;
    margin-bottom: 0;
  }

  /* Chapter Gallery Section */
  .chapter-gallery-section {
    margin-top: 72px;
    padding-top: 36px;
    border-top: 1px solid var(--border-subtle);
  }

  .gallery-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--ink-muted);
  }

  .gallery-count {
    padding: 3px 8px;
    border-radius: 4px;
    background: var(--card-surface);
    border: 1px solid var(--border-subtle);
    font-size: 10px;
    color: var(--sub-accent);
  }

  .chapter-gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .gallery-card {
    display: flex;
    flex-direction: column;
    cursor: pointer;
  }

  .gallery-card-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .gallery-img-box {
    position: relative;
    width: 100%;
    height: 220px;
    border-radius: 12px;
    overflow: hidden;
    background: #EAE6DC;
    border: 1px solid var(--border-subtle);
    padding: 2px;
  }

  .gallery-img-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 10px;
    transition: transform 0.4s ease;
  }

  .gallery-card:hover .gallery-img-box img {
    transform: scale(1.04);
  }

  .gallery-overlay-hint {
    position: absolute;
    top: 10px;
    right: 10px;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(4px);
    color: #fff;
    font-size: 9.5px;
    padding: 2px 7px;
    border-radius: 4px;
    opacity: 0;
    transform: translateY(-4px);
    transition: all 0.25s ease;
    pointer-events: none;
  }

  .gallery-card:hover .gallery-overlay-hint {
    opacity: 1;
    transform: translateY(0);
  }

  .gallery-card-info {
    margin-top: 8px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 10px;
    color: var(--ink-muted);
  }

  .gallery-card-caption {
    font-size: 11px;
    color: var(--ink-primary);
    font-weight: 400;
  }

  .gallery-card-exif {
    font-size: 9.5px;
    opacity: 0.75;
  }

  /* Lightbox Modal */
  .lightbox-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
  }

  .lightbox-modal.active {
    display: flex;
  }

  .lightbox-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(18, 17, 15, 0.92);
    backdrop-filter: blur(8px);
  }

  .lightbox-content {
    position: relative;
    z-index: 10;
    max-width: 92vw;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .lightbox-close {
    position: absolute;
    top: -42px;
    right: 0;
    background: none;
    border: none;
    color: #fff;
    font-size: 20px;
    cursor: pointer;
    opacity: 0.8;
    transition: opacity 0.2s;
  }

  .lightbox-close:hover {
    opacity: 1;
  }

  .lightbox-image-wrap {
    max-width: 90vw;
    max-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-image-wrap img {
    max-width: 100%;
    max-height: 80vh;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }

  .lightbox-meta {
    margin-top: 14px;
    display: flex;
    gap: 16px;
    align-items: center;
    color: #DDD8CD;
    font-size: 11px;
  }

  .lightbox-caption {
    font-weight: 500;
  }

  .lightbox-exif {
    opacity: 0.75;
    padding: 2px 8px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 900px) {
    .chapter-gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .chapter-gallery-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  (function() {
    const modal = document.getElementById('lightboxModal');
    const backdrop = document.getElementById('lightboxBackdrop');
    const closeBtn = document.getElementById('lightboxCloseBtn');
    const imgEl = document.getElementById('lightboxImg');
    const captionEl = document.getElementById('lightboxCaption');
    const exifEl = document.getElementById('lightboxExif');

    if (!modal) return;

    function openLightbox(src, caption, exif) {
      if (!imgEl) return;
      imgEl.src = src;
      imgEl.alt = caption || '';
      if (captionEl) captionEl.textContent = caption || '';
      if (exifEl) exifEl.textContent = exif || '';
      modal.classList.add('active');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      modal.classList.remove('active');
      modal.setAttribute('aria-hidden', 'true');
      if (imgEl) imgEl.src = '';
      document.body.style.overflow = '';
    }

    document.querySelectorAll('.gallery-card').forEach(card => {
      card.addEventListener('click', () => {
        const src = card.getAttribute('data-image');
        const caption = card.getAttribute('data-caption');
        const exif = card.getAttribute('data-exif');
        openLightbox(src, caption, exif);
      });
    });

    if (backdrop) backdrop.addEventListener('click', closeLightbox);
    if (closeBtn) closeBtn.addEventListener('click', closeLightbox);

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('active')) {
        closeLightbox();
      }
    });
  })();
</script>